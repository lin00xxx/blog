<%
var timelinePosts = site.posts.filter(function(p) {
  var hit = false;
  p.categories.each(function(cat) {
    if (cat.name === '动态') hit = true;
  });
  return hit;
}).sort('-date');
%>

<div class="timeline-page">
  <h1 class="timeline-page-title">动态</h1>

  <% if (timelinePosts.length === 0) { %>
    <p class="timeline-empty">还没有动态，去 <code>source/_posts/record/</code> 下写第一篇吧。</p>
  <% } %>

  <div class="timeline">
    <% timelinePosts.each(function(post, index) { %>
      <div class="timeline-item <%= index === 0 ? '' : 'collapsed' %>">
        <!-- 左侧时间轴：点击展开/收起 -->
        <div class="timeline-axis timeline-toggle">
          <div class="timeline-dot"></div>
          <div class="timeline-time">
            <span class="timeline-date"><%= date(post.date, 'MM-DD') %></span>
            <span class="timeline-year"><%= date(post.date, 'YYYY') %></span>
            <span class="timeline-hint"><%= index === 0 ? '收起' : '展开' %></span>
          </div>
        </div>

        <!-- 右侧动态卡片（默认收起，展开后显示） -->
        <div class="timeline-card">
          <div class="timeline-card-inner">
            <div class="timeline-content markdown-body">
              <%- post.content %>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<script>
document.querySelectorAll('.timeline-toggle').forEach(function(el) {
  el.addEventListener('click', function() {
    var item = el.closest('.timeline-item');
    var isOpen = !item.classList.contains('collapsed');
    item.classList.toggle('collapsed');
    var hint = el.querySelector('.timeline-hint');
    if (hint) hint.textContent = isOpen ? '展开' : '收起';
  });
});
</script>
