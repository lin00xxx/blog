<%
if (theme.index.slogan.enable) {
  page.subtitle = theme.index.slogan.text || config.subtitle || ''
}
page.banner_img = theme.index.banner_img
page.banner_img_height = theme.index.banner_img_height
page.banner_mask_alpha = theme.index.banner_mask_alpha
%>

  <h1 style="display: none">
    <%= config.title %>
  </h1>

  <!-- 首页左右布局：左侧打招呼（占比较大），右侧导航小卡片（可无限新增） -->
  <div class="home-layout row">

    <!-- 左侧：打招呼 -->
    <div class="col-12 col-md-7 home-greeting">
      <div class="home-greeting-inner">
        <div class="home-hello">Hi, I'm <span class="home-name">
            <%= config.author || config.title %>
          </span></div>
        <h1 class="home-title">
          <%= page.subtitle || config.subtitle %>
        </h1>
        <p class="home-desc">
          这里是我的小站，记录学习、生活和一些奇思妙想。<br>
          慢慢写，慢慢更，欢迎随便逛逛。
        </p>
        <div class="home-tags">
          <span class="home-tag">记录</span>
          <span class="home-tag">前端</span>
          <span class="home-tag">学习</span>
        </div>
      </div>
    </div>

    <!-- 右侧：导航卡片列表（新增卡片照抄一个 <a class="nav-card"> 即可） -->
    <div class="col-12 col-md-5 home-nav">

      <a class="nav-card" href="<%= url_for('/about/') %>">
        <div class="nav-card-body">
          <h3>关于我</h3>
          <p>一点自我介绍，和正在做的事</p>
        </div>
        <div class="nav-card-arrow">&rarr;</div>
      </a>

      <a class="nav-card" href="<%= url_for('/categories/随笔/') %>">
        <div class="nav-card-body">
          <h3>随笔</h3>
          <p>这里是一些瞎写的东西</p>
        </div>
        <div class="nav-card-arrow">&rarr;</div>
      </a>

      <a class="nav-card" href="<%= url_for('/timeline/') %>">
        <div class="nav-card-body">
          <h3>动态</h3>
          <p>由照片和日记构成的时间线</p>
        </div>
        <div class="nav-card-arrow">&rarr;</div>
      </a>

      <a class="nav-card" href="<%= url_for('/categories/学习/') %>">
        <div class="nav-card-body">
          <h3>学习</h3>
          <p>一些笔记或者瞎搞的项目</p>
        </div>
        <div class="nav-card-arrow">&rarr;</div>
      </a>

      <a class="nav-card" href="<%= url_for('/links/') %>">
        <div class="nav-card-body">
          <h3>友链</h3>
          <p>一些有趣的人</p>
        </div>
        <div class="nav-card-arrow">&rarr;</div>
      </a>

    </div>
  </div>